{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services/voice-agents",
      "destination": "/services/meta-ads/",
      "permanent": false
    },
    {
      "source": "/services/chatbots",
      "destination": "/services/meta-ads/",
      "permanent": false
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/blog/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/demos",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/compare",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/resources",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tools/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/assessment",
      "destination": "/book/",
      "permanent": false
    },
    {
      "source": "/onboarding",
      "destination": "/how-it-works/",
      "permanent": false
    },
    {
      "source": "/partners",
      "destination": "/contact/",
      "permanent": false
    },
    {
      "source": "/testimonials",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/case-studies",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/portfolio",
      "destination": "/",
      "permanent": false
    }
  ]
}